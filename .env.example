HUGGINGFACEHUB_API_TOKEN=your-huggingface-api-token
HF_TOKEN=your-huggingface-api-token
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key

# Gradio server settings (use 0.0.0.0 when running in Docker)
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# Database settings (SQLite)
# DATABASE_PATH is overridden to CONTAINER_DATABASE_PATH by docker-compose environment
DATABASE_PATH=./dbase
LOCAL_DATABASE_PATH=./dbase
CONTAINER_DATABASE_PATH=/app/dbase
DATABASE_NAME=history.sqlite

# Session salt — used to derive deterministic thread IDs from usernames.
# Rotate this value to invalidate all existing sessions.
SESSION_SALT=your-random-salt-here
