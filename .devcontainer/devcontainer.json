{
  "name": "LangChain FastAPI Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/lang-chain-project/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": [
    "/bin/bash",
    "-lc",
    "python -m venv .venv && source .venv/bin/activate && pip install --upgrade pip && pip install -e '.[dev]'"
  ]
}
